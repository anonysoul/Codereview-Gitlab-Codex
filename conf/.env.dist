# 服务端口
SERVER_PORT=5001

# Timezone
TZ=Asia/Shanghai

# 支持 review 的文件类型
SUPPORTED_EXTENSIONS=.c,.cc,.cpp,.cs,.css,.cxx,.go,.h,.hh,.hpp,.hxx,.java,.js,.jsx,.md,.php,.py,.sql,.ts,.tsx,.vue,.yml

# 日志配置
LOG_FILE=log/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3
LOG_LEVEL=DEBUG

# GitLab 配置
# GITLAB_URL={YOUR_GITLAB_URL} # 部分老版本 GitLab webhook 不传递 URL，需要开启此配置，例如：https://gitlab.example.com
# GITLAB_ACCESS_TOKEN={YOUR_GITLAB_ACCESS_TOKEN} # 系统会优先使用此值；未配置时可使用 Webhook 传递的 Secret Token

# 仅当目标分支是受保护分支时才触发 MR review
MERGE_REVIEW_ONLY_PROTECTED_BRANCHES_ENABLED=0

# Codex review 配置
CODEREVIEW_CACHE_DIR=~/.cache/codereview
# CODEX_REVIEW_PROMPT=请用中文输出适合直接回复到 GitLab MR 的审查结论，聚焦 bug、风险、回归和缺失测试。

# Dashboard 登录用户名和密码
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# GitLab domain slugged
WORKER_QUEUE=git_test_com
